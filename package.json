{
  "name": "dsh-notify-plus",
  "version": "0.1.1",
  "description": "Context-rich native notifications for DSH Desktop: the toast title is the live conversation title and the body is a one-line distillation of what the turn produced.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.1-rc.2 <0.2.0",
      "node": ">=22.19.0",
      "systems": [
        "win32"
      ],
      "profiles": [
        "desktop"
      ],
      "dshReleases": {
        "0.1.1-rc.2": "compatible",
        "0.1.5-alpha.2": "compatible",
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible"
      }
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test",
    "verify:layering": "node scripts/verify-layering.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoyin-law/dsh-notify-plus.git"
  },
  "bugs": {
    "url": "https://github.com/hoyin-law/dsh-notify-plus/issues"
  },
  "homepage": "https://github.com/hoyin-law/dsh-notify-plus#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notifications",
    "desktop",
    "electron",
    "windows-toast"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
